:root{
  --bg:#05060c;
  --bg-soft:#0b0e18;
  --surface:rgba(255,255,255,.045);
  --surface-hover:rgba(255,255,255,.075);
  --line:rgba(255,255,255,.1);
  --line-soft:rgba(255,255,255,.06);
  --text:#f3f5fb;
  --muted:#9aa1b8;
  --muted-2:#6c7286;
  --violet:#8b6bff;
  --blue:#4f8bff;
  --cyan:#33e0d6;
  --pink:#ff5fa8;
  --grad:linear-gradient(120deg,var(--blue),var(--violet) 52%,var(--pink));
  --radius:22px;
  --radius-sm:14px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--text);font-family:Manrope,Arial,sans-serif;line-height:1.6;overflow-x:hidden}
.section-shell{width:min(1160px,calc(100% - 48px));margin-inline:auto}
::selection{background:var(--violet);color:#fff}

/* background glows */
.page-glow{position:fixed;z-index:-1;border-radius:50%;filter:blur(110px);pointer-events:none}
.glow-one{width:46rem;height:46rem;background:radial-gradient(circle,rgba(79,139,255,.35),transparent 70%);top:-22rem;right:-18rem}
.glow-two{width:40rem;height:40rem;background:radial-gradient(circle,rgba(139,107,255,.32),transparent 70%);left:-20rem;top:44rem}
.glow-three{position:fixed;z-index:-1;width:34rem;height:34rem;border-radius:50%;filter:blur(110px);background:radial-gradient(circle,rgba(255,95,168,.22),transparent 70%);right:-14rem;bottom:-14rem;pointer-events:none}

/* header */
.site-header{width:min(1160px,calc(100% - 48px));height:92px;margin:auto;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:40}
.site-header::after{content:"";position:absolute;left:0;right:0;top:100%;height:1px;background:var(--line-soft)}
.header-fill{position:fixed;inset:0 0 auto 0;height:92px;z-index:30;backdrop-filter:blur(16px);background:rgba(5,6,12,.55);border-bottom:1px solid var(--line-soft);pointer-events:none}
.brand{color:var(--text);display:flex;align-items:center;gap:11px;text-decoration:none;font-size:.94rem;letter-spacing:-.02em}
.brand img{border-radius:11px;object-fit:cover;box-shadow:0 0 0 1px var(--line)}
.brand b{font-weight:800}
.site-header nav{display:flex;align-items:center;gap:27px}
.site-header nav a{color:var(--muted);text-decoration:none;font-size:.88rem;font-weight:700;transition:color .2s}
.site-header nav a:hover,.text-link:hover{color:#fff}
.site-header .nav-contact{color:var(--bg);background:var(--grad);padding:10px 16px;border-radius:10px;display:flex;align-items:center;gap:6px}
.site-header .nav-contact:hover{filter:brightness(1.08);color:var(--bg)}
.site-header .nav-contact span{color:var(--bg)}
.menu-toggle{display:none}

/* hero */
.hero{min-height:640px;display:grid;grid-template-columns:1.12fr .88fr;gap:6rem;align-items:center;padding-block:88px 76px;position:relative}
.eyebrow,.section-label,.work-number{font-family:"DM Mono",monospace;text-transform:uppercase;letter-spacing:.08em;font-size:.69rem;color:var(--muted)}
.eyebrow{margin:0 0 22px;display:inline-flex;align-items:center;padding:7px 13px 7px 10px;border:1px solid var(--line);border-radius:99px;background:var(--surface)}
.eyebrow span{display:inline-block;width:7px;height:7px;margin-right:9px;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px var(--cyan)}
h1,h2,h3,p{margin-top:0}
h1{font-size:clamp(2.7rem,5vw,4.85rem);line-height:1.07;letter-spacing:-.055em;margin-bottom:27px;max-width:760px;font-weight:800}
h1 em,h2 em{font-style:normal;font-weight:800;letter-spacing:-.05em;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.intro{font-size:1.06rem;color:var(--muted);max-width:600px;line-height:1.85}
.hero-actions,.contact-actions{display:flex;gap:18px;align-items:center;margin-top:38px;flex-wrap:wrap}
.button{display:inline-flex;align-items:center;gap:14px;padding:14px 20px;text-decoration:none;font-size:.85rem;font-weight:800;border-radius:12px;transition:transform .2s,filter .2s,border-color .2s}
.button-primary{color:#fff;background:var(--grad);box-shadow:0 12px 30px -12px rgba(139,107,255,.55)}
.button-primary:hover{transform:translateY(-2px);filter:brightness(1.08)}
.button span{font-size:1.1rem}
.text-link{font-weight:800;color:var(--text);text-decoration:none;font-size:.88rem}
.text-link span{margin-left:5px;color:var(--cyan)}

.profile-panel{border:1px solid var(--line);background:var(--surface);backdrop-filter:blur(18px);padding:16px;border-radius:var(--radius);position:relative}
.profile-panel::before{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;background:var(--grad);opacity:.35;-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;pointer-events:none}
.portrait-wrap{height:360px;border-radius:14px;overflow:hidden;background:#12162280}
.portrait-wrap img{width:100%;height:100%;object-fit:cover;object-position:center 16%}
.profile-heading{padding:22px 8px 12px}
.profile-heading p{font-family:"DM Mono",monospace;text-transform:uppercase;letter-spacing:.08em;font-size:.65rem;color:var(--muted);margin-bottom:4px}
.profile-heading h2{font-size:1.6rem;line-height:1.1;letter-spacing:-.05em;margin:0;font-weight:800}
.status{padding:13px 8px 5px;font-size:.78rem;color:var(--muted);border-top:1px solid var(--line-soft);display:flex;align-items:center}
.status span{width:7px;height:7px;display:inline-block;margin-right:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 10px var(--cyan)}

/* sections */
.section{display:grid;grid-template-columns:170px 1fr;gap:48px;padding-block:108px;border-top:1px solid var(--line-soft)}
.section-label{padding-top:13px}
.section-body h2,.contact h2{font-size:clamp(2rem,3.4vw,3.3rem);line-height:1.14;letter-spacing:-.05em;margin-bottom:32px;font-weight:800}
.about-body{display:grid;grid-template-columns:1.1fr .9fr;gap:5rem}
.about-body>h2{margin:0}
.about-body p,.work-heading>p{color:var(--muted);font-size:.97rem;line-height:1.85}

/* capability grid */
.capability-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;background:var(--line-soft);border:1px solid var(--line-soft);border-radius:var(--radius);overflow:hidden}
.capability-grid article{min-height:210px;padding:26px 24px 22px;background:var(--bg-soft);transition:background .25s}
.capability-grid article:hover{background:var(--surface-hover)}
.capability-grid span{font-family:"DM Mono",monospace;font-size:.7rem;color:var(--cyan)}
.capability-grid h3{font-size:1rem;letter-spacing:-.03em;margin:34px 0 9px;font-weight:800}
.capability-grid p{font-size:.82rem;line-height:1.7;color:var(--muted);margin-bottom:0}

/* sub-heading inside skills section */
.sub-heading{display:flex;align-items:center;gap:14px;margin:56px 0 24px}
.sub-heading h3{font-size:1.02rem;letter-spacing:-.02em;font-weight:800;margin:0;white-space:nowrap}
.sub-heading::after{content:"";flex:1;height:1px;background:var(--line-soft)}

/* tech stack */
.tech-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
.tech-card{display:flex;flex-direction:column;align-items:center;gap:12px;text-align:center;padding:22px 12px;border:1px solid var(--line);border-radius:var(--radius-sm);background:var(--surface);transition:transform .25s,border-color .25s,background .25s}
.tech-card:hover{transform:translateY(-4px);border-color:rgba(139,107,255,.5);background:var(--surface-hover)}
.tech-card span{font-size:.78rem;font-weight:700;color:var(--muted)}
.tech-icon{width:46px;height:46px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.82rem}
.tech-icon svg{width:26px;height:26px}
.tech-icon.py{background:linear-gradient(135deg,#3776ab,#ffd43b)}
.tech-icon.js{background:#f7df1e;color:#111}
.tech-icon.node{background:rgba(131,205,41,.14);color:#83cd29;border:1px solid rgba(131,205,41,.35)}
.tech-icon.react{background:rgba(97,218,251,.12);border:1px solid rgba(97,218,251,.35)}
.tech-icon.next{background:#fff;color:#000}
.tech-icon.express{background:#111318;color:#fff;border:1px solid var(--line);font-style:italic;font-family:Georgia,serif}

/* features */
