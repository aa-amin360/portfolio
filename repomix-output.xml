.feature-card p{font-size:.82rem;line-height:1.7;color:var(--muted);margin:0}

.tools{display:flex;gap:10px;flex-wrap:wrap;margin-top:24px}
.tools span{font:500 .72rem "DM Mono",monospace;border:1px solid var(--line);padding:7px 10px;border-radius:6px;color:#cdd3dd;background:var(--surface)}

/* timeline */
.timeline{border-top:1px solid var(--line-soft)}
.timeline article{display:grid;grid-template-columns:1fr .85fr;gap:3rem;padding:26px 0;border-bottom:1px solid var(--line-soft)}
.timeline h3{margin:7px 0 2px;font-size:1.1rem;letter-spacing:-.04em;font-weight:800}
.timeline .work-number{margin:0}
.timeline .role,.timeline>article>p{margin:0;color:var(--muted);font-size:.84rem;line-height:1.75}

/* work */
.work-heading{display:flex;align-items:end;justify-content:space-between;gap:3rem}
.work-heading h2{max-width:540px}
.work-heading>p{max-width:290px;font-size:.85rem}
.work-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:20px;margin-top:38px}
.work-card{padding:12px;border:1px solid var(--line);border-radius:16px;background:var(--surface);transition:transform .3s,border-color .3s}
.work-card:hover{transform:translateY(-6px);border-color:rgba(139,107,255,.5)}
.work-image{height:195px;overflow:hidden;border-radius:10px;background:linear-gradient(135deg,#1c2440,#101526);display:flex;align-items:center;justify-content:center}
.work-card.featured .work-image{height:270px}
.work-image img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.work-card:hover img{transform:scale(1.06)}
.work-image span{font-size:3rem;font-weight:800;letter-spacing:-.1em;background:var(--grad);-webkit-background-clip:text;background-clip:text;color:transparent}
.work-card h3{font-size:1.05rem;letter-spacing:-.04em;margin:8px 0 5px;font-weight:800}
.work-number{margin:18px 0 0;color:var(--blue);font-size:.62rem}

/* contact */
.contact{padding-block:130px 110px;border-top:1px solid var(--line-soft);position:relative}
.contact h2{font-size:clamp(2.8rem,5.8vw,5.2rem);margin-bottom:0}
.button-outline{border:1px solid var(--line);color:var(--text);background:var(--surface)}
.button-outline:hover{border-color:var(--cyan);transform:translateY(-2px)}

footer{border-top:1px solid var(--line-soft);padding-block:25px 40px;display:flex;justify-content:space-between;color:var(--muted-2);font:400 .68rem "DM Mono",monospace;text-transform:uppercase;letter-spacing:.06em}

.reveal{opacity:0;transform:translateY(20px);transition:opacity .65s ease,transform .65s ease}
.reveal.visible{opacity:1;transform:none}
.skip-link{position:absolute;left:-999px}
.skip-link:focus{left:15px;top:15px;background:white;color:black;padding:10px;z-index:10}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}

/* ===== tablet ===== */
@media (max-width:1024px){
  .capability-grid{grid-template-columns:repeat(2,1fr)}
  .tech-grid{grid-template-columns:repeat(3,1fr)}
  .feature-grid{grid-template-columns:repeat(2,1fr)}
  .work-grid{grid-template-columns:1fr 1fr;grid-template-areas:"a a" "b c"}
  .work-card.featured{grid-area:a}
  .hero{gap:3.5rem}
}

/* ===== mobile ===== */
@media (max-width:800px){
  .section-shell,.site-header{width:min(100% - 32px,1160px)}
  .site-header,.header-fill{height:75px}
  .menu-toggle{display:flex;width:38px;height:38px;border:1px solid var(--line);background:var(--surface);border-radius:9px;align-items:center;justify-content:center;flex-direction:column;gap:5px;z-index:41}
  .menu-toggle i{display:block;width:16px;height:1px;background:var(--text)}
  .site-header nav{display:none;position:absolute;right:0;top:57px;background:rgba(11,14,24,.92);backdrop-filter:blur(18px);border:1px solid var(--line);border-radius:14px;padding:15px;width:200px;flex-direction:column;align-items:stretch;gap:3px;z-index:41}
  .site-header nav.open{display:flex}
  .site-header nav a{padding:10px}
  .site-header .nav-contact{text-align:center;justify-content:center;margin-top:5px}
  .hero{min-height:0;grid-template-columns:1fr;gap:45px;padding-block:44px 60px}
  .hero-copy{order:1}
  .profile-panel{max-width:360px;justify-self:center;order:2;width:100%}
  .portrait-wrap{height:300px}
  h1{font-size:clamp(2.6rem,11vw,3.6rem)}
  .section{grid-template-columns:1fr;gap:19px;padding-block:66px}
  .section-label{padding:0}
  .about-body{grid-template-columns:1fr;gap:25px}
  .capability-grid{grid-template-columns:1fr}
  .capability-grid article{min-height:0;padding:22px 20px}
  .capability-grid h3{margin:18px 0 6px}
  .sub-heading{margin:44px 0 18px}
  .sub-heading h3{font-size:.92rem}
  .tech-grid{grid-template-columns:repeat(3,1fr);gap:10px}
  .tech-card{padding:16px 8px}
  .feature-grid{grid-template-columns:1fr;gap:12px}
  .work-heading{display:block}
  .work-heading>p{max-width:500px;margin-top:10px}
  .work-grid{grid-template-columns:1fr;grid-template-areas:none;gap:16px}
  .work-card.featured .work-image,.work-image{height:220px}
  .contact{padding-block:80px 70px}
  footer{padding-block:22px 32px;flex-direction:column;gap:8px}
  .reveal{transition-duration:.45s}
}

@media (max-width:480px){
  .tech-grid{grid-template-columns:repeat(2,1fr)}
}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  .reveal{opacity:1;transform:none;transition:none}
  .button,.work-card,.work-image img,.tech-card,.feature-card{transition:none}
}

@media print{
  .reveal{opacity:1!important;transform:none!important}
  .header-fill,.page-glow,.glow-three{display:none}
}
